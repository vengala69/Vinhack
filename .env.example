# Copy this file to .env and fill in your key.
# .env is gitignored - never commit a real key.

# Required for the Therapist chat. Without it that endpoint returns 503 and the
# page says so plainly; every other screen works unchanged.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional - defaults shown. The model is read from the environment so it is
# not hardcoded in the source.
# LLM_MODEL=claude-opus-5
# LLM_MAX_TOKENS=700
# LLM_MAX_HISTORY=12

# Optional - where the SQLite file lives.
# VINHACK_DB=db/vinhack.db
