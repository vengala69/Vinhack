# Copy this file to .env and fill in your key.
# .env is gitignored - never commit a real key.

# --- Therapist chat -------------------------------------------------
# Any OpenAI-compatible provider works; only the key and base URL change.
# Without a key that endpoint returns 503 and the page says so plainly.
# Every other screen works unchanged.
#
# Groq (default, free, no card): https://console.groq.com/keys
LLM_API_KEY=gsk_your_key_here

# Optional - defaults shown. Nothing is hardcoded in the source.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_MAX_TOKENS=700
# LLM_MAX_HISTORY=12
# LLM_TIMEOUT=30
#
# Other providers, for reference:
#   OpenAI      LLM_BASE_URL=https://api.openai.com/v1
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1
#   Ollama      LLM_BASE_URL=http://127.0.0.1:11434/v1   LLM_API_KEY=ollama

# Optional - where the SQLite file lives.
# VINHACK_DB=db/vinhack.db
